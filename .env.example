# Copy to .env for local runs. Never commit the real file.

# REQUIRED, and deliberately has no default.
# The SDK resolves its host as `baseUrl ?? environment[environmentKey]`, and its
# only built-in environment is production — so an unset value would silently
# connect to wss://api.deepgram.com. This build is staging-only, so the server
# refuses to start rather than default. Production hosts are rejected outright.
DEEPGRAM_BASE_URL=wss://<staging-host>

# REQUIRED. Named for staging specifically so a production key in
# DEEPGRAM_API_KEY cannot be picked up by accident.
DEEPGRAM_STAGING_API_KEY=<staging-key>

PORT=8080

# Rate limits. Placeholder values — the real numbers belong with the spend-cap
# decision in FLAGS.md F-002.
GLOBAL_PER_MINUTE=20
GLOBAL_PER_DAY=500
PER_IP_PER_MINUTE=5
MAX_CONCURRENT=2

# 0 ignores X-Forwarded-For entirely, so a forged header cannot influence per-IP
# limits. Set to 1 behind Fly.io.
TRUSTED_PROXY_HOPS=0
